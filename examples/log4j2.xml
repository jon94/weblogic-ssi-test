# app/src/WEB-INF/classes/log4j2.xml
#
# Log4j2 config for trace-log correlation with Datadog.
# Place in WEB-INF/classes/ so it is on the app's classpath.
#
# The %X{dd.*} MDC placeholders are populated automatically by the
# Datadog Java agent when DD_LOGS_INJECTION=true is set and an active
# trace span exists for the request.
#
# Also requires weblogic.xml with prefer-application-packages to ensure
# WebLogic uses the app's Log4j2 JARs instead of its own bundled version.

<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <File name="AppLog" fileName="/opt/oracle/logs/petclinic-app.log" append="true">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg [dd.trace_id=%X{dd.trace_id} dd.span_id=%X{dd.span_id} dd.service=%X{dd.service} dd.env=%X{dd.env} dd.version=%X{dd.version}]%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="AppLog"/>
    </Root>
  </Loggers>
</Configuration>
