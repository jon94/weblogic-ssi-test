<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <File name="AppLog" fileName="/opt/oracle/logs/petclinic-app.log" append="true">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg [dd.trace_id=%X{dd.trace_id} dd.span_id=%X{dd.span_id} dd.service=%X{dd.service} dd.env=%X{dd.env} dd.version=%X{dd.version}]%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="AppLog"/>
    </Root>
  </Loggers>
</Configuration>
